<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_association_appointment_portal" model="ir.rule">
            <field name="name">Mes Rendez-vous (Portail Mamans)</field>
            <!-- 🌟 Syntaxe alternative très robuste pour l'ID du modèle -->
            <field name="model_id" search="[('model', '=', 'association.appointment')]"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('member_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

    </data>
</odoo>
